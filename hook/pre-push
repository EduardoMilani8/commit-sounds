#!/usr/bin/env bash
CS="$HOME/.commit-sounds/commit_sounds.py"
[[ -f "$CS" ]] || exit 0

while read -r local_ref local_oid remote_ref remote_oid; do
    [[ -z "$local_ref" || "$local_oid" =~ ^0+$ ]] && continue
    case "$remote_ref" in
        refs/heads/*|refs/tags/*)
            setsid nohup python3 "$CS" avisar </dev/null >/dev/null 2>&1 &
            exit 0
            ;;
    esac
done
exit 0
