#!/usr/bin/env bash
set -u

CONF="$HOME/.git-hooks/hook-config.sh"
if [[ ! -f "$CONF" ]]; then
    exit 0
fi
# shellcheck disable=SC1090
source "$CONF"

if [[ -z "${CS_AMIGO:-}" ]]; then
    exit 0
fi
if [[ ! -v CS_TARGETS ]] || [[ ${#CS_TARGETS[@]} -eq 0 ]]; then
    exit 0
fi

pushing=0
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ -z "$local_ref" ]]; then
        continue
    fi
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue
    fi
    case "$local_ref" in
        refs/heads/*|refs/tags/*)
            pushing=1
            ;;
    esac
    [[ "$pushing" -eq 1 ]] && break
done

if [[ "$pushing" -ne 1 ]]; then
    exit 0
fi

for alvo in "${CS_TARGETS[@]}"; do
    url="${alvo%%|*}"
    token="${alvo#*|}"
    if [[ -z "$url" ]]; then
        continue
    fi
    dados="{\"secreto\":\"$token\",\"amigo\":\"$CS_AMIGO\"}"
    curl -sf --max-time 2 -X POST "$url/play" \
        -H 'Content-Type: application/json' \
        -d "$dados" >/dev/null 2>&1 || true
done

exit 0